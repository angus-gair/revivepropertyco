# Hipages Scraper Service Environment Variables

# REQUIRED: Hipages.com.au credentials
HIPAGES_USERNAME=your-email@example.com
HIPAGES_PASSWORD=your-password-here

# REQUIRED: PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://homelab:your-password@postgres:5432/revivepropertyco

# OPTIONAL: Scraper configuration
HIPAGES_HEADLESS=true
CRON_SCHEDULE=0 */6 * * *
RUN_ON_STARTUP=false

# OPTIONAL: Lock file path (default: /tmp/hipages-scraper.lock)
LOCK_FILE=/tmp/hipages-scraper.lock

# OPTIONAL: Output directory for debug files
OUTPUT_DIR=/app/output
